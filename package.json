{
  "name": "kh-address",
  "version": "1.1.2",
  "description": "Cambodian address data with Khmer and English names.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "data/cambodia.json"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --target es2020 --external ../data/cambodia.json --dts --clean && node scripts/patch-esm-json.js",
    "dev": "tsup src/index.ts --format cjs,esm --target es2020 --external ../data/cambodia.json --dts --watch",
    "prepublishOnly": "npm run build && npm test",
    "test": "node test/test.js"
  },
  "keywords": [
    "cambodia",
    "cambodian",
    "khmer",
    "address",
    "administrative",
    "geodata",
    "autocomplete",
    "province",
    "district",
    "commune",
    "village",
    "kh"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
